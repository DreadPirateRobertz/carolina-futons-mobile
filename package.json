{
  "name": "carolina-futons-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "test": "npx jest",
    "test:watch": "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "pipeline:generate": "npx tsx scripts/pipeline/generate.ts",
    "pipeline:convert": "npx tsx scripts/pipeline/convert.ts",
    "pipeline:validate": "npx tsx scripts/pipeline/validate.ts --dir scripts/pipeline/output",
    "pipeline:sync": "npx tsx scripts/pipeline/sync-catalog.ts",
    "pipeline:all": "npm run pipeline:generate && npm run pipeline:convert && npm run pipeline:validate && npm run pipeline:sync",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "e2e:prebuild": "npx expo prebuild --clean",
    "screenshots": "bash scripts/take-screenshots.sh all",
    "screenshots:ios": "bash scripts/take-screenshots.sh ios",
    "screenshots:android": "bash scripts/take-screenshots.sh android",
    "catalog:sync": "npx tsx scripts/sync-3d-catalog.ts",
    "catalog:check": "npx tsx scripts/sync-3d-catalog.ts --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@sentry/react-native": "~7.13.0",
    "@stripe/stripe-react-native": "0.58.0",
    "@wix/members": "^1.0.455",
    "@wix/sdk": "^1.21.3",
    "expo": "^55",
    "expo-apple-authentication": "~55.0.9",
    "expo-application": "~55.0.10",
    "expo-asset": "~55.0.10",
    "expo-blur": "~55.0.10",
    "expo-camera": "~55.0.11",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.10",
    "expo-device": "~55.0.10",
    "expo-file-system": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image": "~55.0.6",
    "expo-image-manipulator": "~55.0.11",
    "expo-image-picker": "~55.0.13",
    "expo-linking": "~55.0.8",
    "expo-local-authentication": "~55.0.9",
    "expo-media-library": "~55.0.10",
    "expo-notifications": "~55.0.13",
    "expo-secure-store": "~55.0.9",
    "expo-sharing": "~55.0.14",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-store-review": "~55.0.9",
    "expo-video": "~55.0.11",
    "expo-web-browser": "~55.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-purchases": "^9.11.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "~4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.4.0",
    "@types/detox": "^17.14.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "detox": "^20.50.1",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "expo-auth-session": "~55.0.9",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-circus": "^30.3.0",
    "jest-expo": "~55.0.11",
    "lint-staged": "^16.4.0",
    "prettier": "^3.2.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "tar": "^7.5.12"
  }
}
